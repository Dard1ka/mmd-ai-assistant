# =====================================================
# MMD AI Assistant — Environment Variables Template
# =====================================================
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored — never commit real secrets

# ---------- Telegram Bot ----------
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username

# ---------- n8n ----------
N8N_URL=http://localhost:5678
# Public URL via Cloudflare tunnel (set after `cloudflared tunnel --url http://localhost:5678`)
N8N_PUBLIC_URL=https://your-tunnel-name.trycloudflare.com

# ---------- OpenAI ----------
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# ---------- Cloudflare Tunnel ----------
CLOUDFLARED_PATH=./tools/cloudflared.exe

# ---------- File Paths ----------
# Your MMD library directory (containing Model/, Motion/, Background/ subfolders)
MMD_LIBRARY_PATH=D:/Data MMD

# Blender render script
BLENDER_RENDER_SCRIPT=./mmd-renderer/render_mmd.py

# Optional: Genshin Shader blend file
GENSHIN_SHADER_BLEND=./_genshin_shader.blend

# ---------- Optional: Google Sheets (future) ----------
GOOGLE_SHEET_LOG_ID=
GOOGLE_SERVICE_ACCOUNT_PATH=

# ---------- Optional: Supabase RAG (future) ----------
SUPABASE_URL=
SUPABASE_KEY=

# ---------- Rate Limiting ----------
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW=3600
